{
  "name": "batloung-farm-dms",
  "version": "1.0.0",
  "description": "Batloung Farm Distribution Management System - Express + MySQL REST API (DIWA2110 take-home test)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node scripts/setupDatabase.js",
    "db:setup:hosted": "node scripts/setupDatabase.js --skip-db-create",
    "demo:rollback": "node scripts/demoRollback.js",
    "demo:api": "node scripts/demoApi.js",
    "test:logic": "node tests/logic.test.js"
  },
  "engines": {
