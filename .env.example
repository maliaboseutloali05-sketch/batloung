# Copy this file to ".env" and fill in your own values.  NEVER commit ".env".

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- MySQL (no defaults for the password on purpose) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=batloung_farm_dms
DB_CONNECTION_LIMIT=10
# Set to true for hosted MySQL providers that require TLS (Aiven, Railway, PlanetScale-style)
DB_SSL=false

# ---- Optional admin protection ----
# When set, every /api request (except /api/health) must send header:  x-api-key: <value>
ADMIN_API_KEY=
